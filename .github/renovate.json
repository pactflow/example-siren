{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "pre-commit": {
    "enabled": true
  },
  "git-submodules": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "The provider serialises Siren through spring-hateoas-siren 1.3.0, which supports only Spring HATEOAS 1.x / Spring Boot 2.x (ingogriebsch/spring-hateoas-siren#481). Spring Boot 2.7's Gradle plugin in turn needs Gradle < 9.",
      "matchFileNames": [
        "provider/**"
      ],
      "matchPackageNames": [
        "org.springframework.boot{/,}**",
        "gradle"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
